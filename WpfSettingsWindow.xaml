<Window x:Class="Rounder.Windows.WpfSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rounder Settings"
        Width="760"
        Height="780"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System"
        Background="Transparent"
        Icon="pack://application:,,,/Assets/rounder.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="RounderWindowBrush" Color="#8C1F1F1F"/>
            <SolidColorBrush x:Key="RounderSidebarBrush" Color="#B02A2A2A"/>
            <SolidColorBrush x:Key="RounderPanelBrush" Color="#A82F2F2F"/>
            <SolidColorBrush x:Key="RounderFooterBrush" Color="#BC292929"/>
            <SolidColorBrush x:Key="RounderBorderBrush" Color="#55FFFFFF"/>
            <SolidColorBrush x:Key="RounderTextBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="RounderSecondaryTextBrush" Color="#B8B8B8"/>
            <SolidColorBrush x:Key="RounderHoverBrush" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="RounderPressedBrush" Color="#454545"/>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource RounderTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource RounderFooterBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RounderBorderBrush}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource RounderTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource RounderFooterBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RounderBorderBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <TextBlock Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="{DynamicResource RounderSecondaryTextBrush}"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource RounderFooterBrush}"
                                        BorderBrush="{DynamicResource RounderBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RounderHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource RounderTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource RounderFooterBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RounderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RounderPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource RounderTextBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource RounderTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource RounderFooterBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RounderBorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RounderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RounderPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem" x:Key="SidebarItemStyle">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource RounderTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="8,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RounderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource RounderTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource RounderWindowBrush}"
          TextElement.Foreground="{DynamicResource RounderTextBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource RounderSidebarBrush}"
                BorderBrush="{DynamicResource RounderBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="10,28,10,10">
                <Grid DockPanel.Dock="Top" Margin="8,0,4,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Width="30" Height="30" Source="pack://application:,,,/Assets/rounder.png" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Rounder" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Version 2.1.4" FontSize="11" Foreground="{DynamicResource RounderSecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="SidebarList"
                         DockPanel.Dock="Top"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}"
                         SelectionChanged="SidebarList_SelectionChanged">
                    <ListBoxItem Tag="General">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="22"/>
                            <TextBlock Text="General"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Appearance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Width="22"/>
                            <TextBlock Text="Appearance"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Corners">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A3;" FontFamily="Segoe MDL2 Assets" Width="22"/>
                            <TextBlock Text="Corners"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Displays">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Width="22"/>
                            <TextBlock Text="Displays"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Gaming">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Width="22"/>
                            <TextBlock Text="Gaming"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsHitTestVisible="False" Focusable="False">
                        <Separator Margin="0,5"/>
                    </ListBoxItem>
                    <ListBoxItem Tag="Presets">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" Width="22"/>
                            <TextBlock Text="Presets"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Permissions">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" Width="22"/>
                            <TextBlock Text="Permissions"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Width="22"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="DetailScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="DetailScroll_ScrollChanged">
                <StackPanel Margin="20" x:Name="SectionsPanel">
                    <StackPanel x:Name="GeneralSection" Tag="General" Margin="0,0,0,28">
                        <TextBlock Text="General" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Padding="16" CornerRadius="12" Background="{DynamicResource RounderPanelBrush}" BorderBrush="{DynamicResource RounderBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="EnabledBox" Content="Enable rounded corners" Margin="0,0,0,12"/>
                                <Separator Margin="0,0,0,12"/>
                                <CheckBox x:Name="LaunchAtLoginBox" Content="Launch at login"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AppearanceSection" Tag="Appearance" Margin="0,0,0,28">
                        <TextBlock Text="Appearance" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Padding="16" CornerRadius="12" Background="{DynamicResource RounderPanelBrush}" BorderBrush="{DynamicResource RounderBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Corner radius" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="RadiusText" Width="58" HorizontalContentAlignment="Center"/>
                                        <TextBlock Text="px" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource RounderSecondaryTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="RadiusSlider" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,16"/>
                                <Separator Margin="0,0,0,16"/>
                                <TextBlock Text="Corner shape" Foreground="{DynamicResource RounderSecondaryTextBrush}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="CutoutStyleBox" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                    <ComboBoxItem Content="Rounded"/>
                                    <ComboBoxItem Content="Squircle"/>
                                    <ComboBoxItem Content="Polygon cutout"/>
                                </ComboBox>
                                <Separator Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Corner color" VerticalAlignment="Center"/>
                                    <Border x:Name="ColorPreview" Grid.Column="1" Width="44" Height="28" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource RounderBorderBrush}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Black" Click="Black_Click" Margin="0,0,8,0"/>
                                    <Button Content="White" Click="White_Click" Margin="0,0,8,0"/>
                                    <Button Content="Gray" Click="Gray_Click" Margin="0,0,8,0"/>
                                    <Button Content="Custom..." Click="CustomColor_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="CornersSection" Tag="Corners" Margin="0,0,0,28">
                        <TextBlock Text="Corners" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Padding="16" CornerRadius="12" Background="{DynamicResource RounderPanelBrush}" BorderBrush="{DynamicResource RounderBorderBrush}" BorderThickness="1">
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="TopLeftBox" Content="Top left" Margin="0,0,20,12"/>
                                <CheckBox x:Name="TopRightBox" Content="Top right" Margin="0,0,0,12"/>
                                <CheckBox x:Name="BottomLeftBox" Content="Bottom left" Margin="0,0,20,0"/>
                                <CheckBox x:Name="BottomRightBox" Content="Bottom right"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DisplaysSection" Tag="Displays" Margin="0,0,0,28">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Displays" FontSize="22" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="Refresh monitors" Click="RefreshMonitors_Click"/>
                        </Grid>
                        <Border Padding="16" CornerRadius="12" Background="{DynamicResource RounderPanelBrush}" BorderBrush="{DynamicResource RounderBorderBrush}" BorderThickness="1">
                            <ListBox x:Name="DisplayList" MinHeight="160" BorderThickness="0" Background="Transparent"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="GamingSection" Tag="Gaming" Margin="0,0,0,28">
                        <TextBlock Text="Gaming" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Padding="16" CornerRadius="12" Background="{DynamicResource RounderPanelBrush}" BorderBrush="{DynamicResource RounderBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Mode" Foreground="{DynamicResource RounderSecondaryTextBrush}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="GamingBox" Grid.Column="1" Content="Enable animated rainbow glow"/>
                                <TextBlock Grid.Row="1" Text="Speed" Foreground="{DynamicResource RounderSecondaryTextBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBox x:Name="SpeedText" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                <TextBlock Grid.Row="2" Text="Glow intensity" Foreground="{DynamicResource RounderSecondaryTextBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBox x:Name="GlowText" Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                <TextBlock Grid.Row="3" Text="Bloom width" Foreground="{DynamicResource RounderSecondaryTextBrush}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBox x:Name="BloomText" Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PresetsSection" Tag="Presets" Margin="0,0,0,28">
                        <TextBlock Text="Presets" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Padding="16" CornerRadius="12" Background="{DynamicResource RounderPanelBrush}" BorderBrush="{DynamicResource RounderBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="260"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="PresetList"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <Button Content="Apply" Margin="0,0,0,8" Click="ApplyPreset_Click"/>
                                    <Button Content="Save Current..." Margin="0,0,0,8" Click="SaveCurrent_Click"/>
                                    <Button Content="Edit..." Margin="0,0,0,8" Click="EditPreset_Click"/>
                                    <Button Content="Delete" Margin="0,0,0,8" Click="DeletePreset_Click"/>
                                    <Button Content="Import..." Margin="0,0,0,8" Click="ImportPresets_Click"/>
                                    <Button Content="Export..." Click="ExportPresets_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="PresetDetails" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource RounderSecondaryTextBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PermissionsSection" Tag="Permissions" Margin="0,0,0,28">
                        <TextBlock Text="Permissions" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Padding="16" CornerRadius="12" Background="{DynamicResource RounderPanelBrush}" BorderBrush="{DynamicResource RounderBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Windows does not require Accessibility, Screen Recording, or Automation permissions for Rounder." TextWrapping="Wrap" Foreground="{DynamicResource RounderSecondaryTextBrush}" Margin="0,0,0,14"/>
                                <TextBlock Text="Overlay windows: Granted"/>
                                <TextBlock Text="Display changes: Granted" Margin="0,5,0,0"/>
                                <TextBlock Text="Startup automation: Optional" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutSection" Tag="About" Margin="0,0,0,24">
                        <TextBlock Text="About" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Padding="16" CornerRadius="12" Background="{DynamicResource RounderPanelBrush}" BorderBrush="{DynamicResource RounderBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Developer" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="- Nisesimadao - Developer" Foreground="{DynamicResource RounderSecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="- SwiftUI &amp; AppKit implementation" Foreground="{DynamicResource RounderSecondaryTextBrush}" Margin="0,0,0,16"/>
                                <TextBlock Text="Technology" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="- Core Graphics drawing engine" Foreground="{DynamicResource RounderSecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="- NSWindow overlay system" Foreground="{DynamicResource RounderSecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="- UserDefaults settings management" Foreground="{DynamicResource RounderSecondaryTextBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="- Windows port: .NET 9, WinForms tray/overlay host, WPF settings UI, GDI+, and Win32 window styles" TextWrapping="Wrap" Foreground="{DynamicResource RounderSecondaryTextBrush}" Margin="0,0,0,16"/>
                                <TextBlock Text="License" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="- MIT License" Foreground="{DynamicResource RounderSecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="- Open source project" Foreground="{DynamicResource RounderSecondaryTextBrush}" Margin="0,0,0,16"/>
                                <Separator Margin="0,0,0,16"/>
                                <TextBlock Text="Support" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Report bugs and feature requests through the GitHub repository." Foreground="{DynamicResource RounderSecondaryTextBrush}" Margin="0,0,0,10"/>
                                <Button Content="Open GitHub" HorizontalAlignment="Left" Click="OpenGithub_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource RounderBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource RounderFooterBrush}">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Exit" Click="Exit_Click" Foreground="#C42B1C"/>
                    <TextBlock Grid.Column="1" Text="Apply updates the live overlays immediately." VerticalAlignment="Center" Margin="16,0,16,0" Foreground="{DynamicResource RounderSecondaryTextBrush}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Cancel" MinWidth="88" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button Content="Apply" MinWidth="88" Margin="0,0,8,0" Click="Apply_Click"/>
                        <Button Content="OK" MinWidth="88" Click="Ok_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
